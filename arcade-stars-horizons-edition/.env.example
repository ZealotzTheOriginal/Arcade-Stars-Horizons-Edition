# Copia este archivo a .env (ignorado por git) para ejecutar el servidor en local.
# En Render se definen las mismas variables en el panel (Environment).

# ── Servidor (SECRETAS: nunca en el cliente ni en git) ───
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Render la inyecta sola; en local por defecto 9080.
# PORT=9080

# ── Solo desarrollo local ────────────────────────────────
# Salta Supabase y acepta tokens "dev:<id>". NO definir en Render.
# ASH_DEV_AUTH=1

# ── Cliente (opcionales) ─────────────────────────────────
# La URL pública del servidor va en scripts/net/app_config.gd (SERVER_URL).
# ASH_SERVER_URL=ws://127.0.0.1:9080
# ASH_PROFILE=2
